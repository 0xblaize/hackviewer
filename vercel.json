{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "redirects": [
    {
      "source": "/public/index.php",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/index.php",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/assets/:path*",
      "destination": "/public/assets/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.php"
    }
  ]
}
