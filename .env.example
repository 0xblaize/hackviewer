APP_TIMEZONE=UTC
DATABASE_PATH=database/app.sqlite

# Official X API credentials. Do not commit your real .env file.
X_BEARER_TOKEN=
X_API_BASE_URL=https://api.x.com/2
X_SEARCH_QUERY=(hackathon OR hackathons OR buildathon) -is:retweet lang:en

# Add only official or explicitly permitted machine-readable endpoints.
# Leave blank to keep a platform manual-only.
DEVPOST_ENDPOINT_URL=
DORAHACKS_ENDPOINT_URL=
MLH_ENDPOINT_URL=
HACKEREARTH_ENDPOINT_URL=
KAGGLE_ENDPOINT_URL=
HACKQUEST_ENDPOINT_URL=
UNSTOP_ENDPOINT_URL=

# Sorsa API for X/Twitter post discovery
# Get your own key from Sorsa. Never commit or share it.
SORSA_API_KEY=
SORSA_API_BASE_URL=https://api.sorsa.io/v3
SORSA_SEARCH_ENDPOINT_URL=https://api.sorsa.io/v3/search-tweets
SORSA_SEARCH_QUERY=hackathon
SORSA_SEARCH_QUERY_FIELD=query
SORSA_BATCH_QUERIES=["hackathon","buildathon","hackathon prizes","hackathon applications","developer competition"]
